{%- comment -%}
  Inline line icons (24 × 24), always decorative: each sits next to visible text.
  Usage: {% render 'icon', name: 'check', class: 'ms-icon' %}
{%- endcomment -%}
{%- liquid
  assign width = '2'
  if name == 'loop' or name == 'clock' or name == 'energy'
    assign width = '1.5'
  endif
-%}
{%- if name == 'quote' -%}
  <svg class="{{ class }}" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4 26V16.5C4 10 7.6 6.2 13 5l1.2 2.6C10.9 8.7 9.4 11 9.3 14H13v12H4Zm15 0V16.5C19 10 22.6 6.2 28 5l1.2 2.6c-3.3 1.1-4.8 3.4-4.9 6.4H28v12h-9Z"/></svg>
{%- else -%}
  <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ width }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {%- case name -%}
      {%- when 'external' -%}<path d="M7 17 17 7M8 7h9v9"/>
      {%- when 'check' -%}<path d="m5 12.5 4.5 4.5L19 7.5"/>
      {%- when 'instagram' -%}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
      {%- when 'mail' -%}<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/>
      {%- when 'info' -%}<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>
      {%- when 'loop' -%}<path d="M4 12a8 8 0 0 1 13.7-5.6M20 12a8 8 0 0 1-13.7 5.6"/><path d="M18 3v3.6h-3.6M6 21v-3.6h3.6"/>
      {%- when 'clock' -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
      {%- when 'energy' -%}<path d="M13 2.5 4.5 13.5H11l-1 8 8.5-11H12l1-8Z"/>
    {%- endcase -%}
  </svg>
{%- endif -%}
