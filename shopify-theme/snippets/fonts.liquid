{%- comment -%}
  Anton (headlines) and Poppins (text), self-hosted from assets/ (SIL Open Font
  License). Latin plus latin-ext, which has the Polish letters; each file is
  only downloaded when the page uses a character in its range.
{%- endcomment -%}
{{ 'anton-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{{ 'poppins-400-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{% style %}
  @font-face {
    font-family: "Anton";
    src: url("{{ 'anton-latin-ext.woff2' | asset_url }}") format("woff2");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
