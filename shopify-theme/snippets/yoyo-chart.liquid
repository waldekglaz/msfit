{%- comment -%}
  Illustrative chart with no numbers: a yo-yo diet's swings against a steady,
  tailored plan. The pink line draws itself as the chart scrolls into view.
  Params: title, description, axis_y, axis_x, yoyo_label, steady_label, caption
{%- endcomment -%}
{%- assign chart_id = 'yoyo-' | append: section.id -%}
<figure class="ms-chart">
  <h3 class="ms-display">{{ title | escape }}</h3>
  <svg viewBox="0 0 480 270" role="img" aria-labelledby="{{ chart_id }}-title {{ chart_id }}-desc">
    <title id="{{ chart_id }}-title">{{ title | escape }}</title>
    <desc id="{{ chart_id }}-desc">{{ description | escape }}</desc>
    <path d="M32 18 V 238 H 466" stroke="#4D4D4D" stroke-width="1.5" fill="none"/>
    <text transform="translate(20 128) rotate(-90)" fill="#A8A8A8" font-size="18" text-anchor="middle">{{ axis_y | escape }}</text>
    <text x="466" y="262" fill="#A8A8A8" font-size="18" text-anchor="end">{{ axis_x | escape }}</text>
    <path d="M40 70 C 70 70, 78 150, 104 150 S 130 86, 152 86 S 184 176, 212 176 S 240 70, 266 70 S 296 160, 322 160 S 350 52, 378 52 S 408 128, 432 120 S 444 46, 452 44" stroke="#8C8C8C" stroke-width="3" stroke-dasharray="7 7" stroke-linecap="round" fill="none"/>
    <path class="ms-draw" d="M40 70 C 120 78, 170 150, 250 186 S 380 214, 452 212" pathLength="1" style="stroke: var(--ms-pink)" stroke-width="5" stroke-linecap="round" fill="none"/>
    <circle cx="40" cy="70" r="6" style="fill: var(--ms-pink)"/>
  </svg>
  <ul class="ms-chart__legend" aria-label="{{ 'accessibility.chart_legend' | t }}">
    <li>
      <svg width="36" height="8" aria-hidden="true"><path d="M2 4h32" stroke="#8C8C8C" stroke-width="3" stroke-dasharray="6 6" stroke-linecap="round"/></svg>
      {{ yoyo_label | escape }}
    </li>
    <li>
      <svg width="36" height="8" aria-hidden="true"><path d="M2 4h32" style="stroke: var(--ms-pink)" stroke-width="5" stroke-linecap="round"/></svg>
      {{ steady_label | escape }}
    </li>
  </ul>
  {%- if caption != blank -%}
    <figcaption>{{ caption | escape }}</figcaption>
  {%- endif -%}
</figure>
