{%- comment -%} Shown while the store is password protected (before launch). {%- endcomment -%}
<div class="ms-center">
  <div class="ms-page">
    <p class="ms-display ms-logo">{{ shop.name | escape }}<span>.</span></p>
    <h1 class="ms-display ms-page-title ms-space">{{ 'password.title' | t }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="ms-lead ms-intro">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'ms-form' -%}
      {%- if form.errors -%}
        <div class="ms-alert" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div>
        <label for="Password">{{ 'password.label' | t }}</label>
        <input class="ms-field" id="Password" type="password" name="password" autocomplete="current-password" required>
      </div>
      <button class="ms-button" type="submit">{{ 'password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Hasło sklepu",
  "tag": "div"
}
{% endschema %}
