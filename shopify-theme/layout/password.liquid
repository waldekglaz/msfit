<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ shop.name }}</title>
    {% render 'fonts' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {% style %}
      :root { --ms-pink: {{ settings.color_accent }}; --ms-pink-hover: {{ settings.color_accent | color_darken: 8 }}; }
    {% endstyle %}
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
