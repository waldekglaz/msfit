# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=
# Where contact-form messages are delivered (Marta's inbox)
CONTACT_TO_EMAIL=
# Optional: sender address on a domain verified in Resend,
# e.g. "MS Fit Coaching <formularz@msfitcoaching.pl>".
# Defaults to Resend's test sender, which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=

# Optional: the final public URL, used for canonical/OpenGraph/sitemap links.
# On Vercel the production domain is detected automatically if this is empty.
NEXT_PUBLIC_SITE_URL=
